digraph G {
  rankdir=LR; splines=spline; nodesep=0.35; ranksep=0.55; pad=0.2;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#2a78d6", fillcolor="#f3f6fb", penwidth=1.3, margin="0.18,0.10"];
  edge [color="#555555", penwidth=1.1, arrowsize=0.7, fontname="Helvetica", fontsize=9, fontcolor="#555555"];

  report [label=<<b>KOFICE report (2026)</b><br/><font point-size="9.5">respondent profile, 30 countries<br/>printed outcomes: XQ5, XQ6, POPMEAN<br/>3-band and 13-domain totals</font>>, color="#c98a1a", fillcolor="#fff8ec"];
  personas [label=<<b>Personas</b><br/><font point-size="9.5">IPF on printed margins<br/>100 personas per country (3,000)<br/>network subsample 30 per country</font>>];
  r1 [label=<<b>Round 1</b><br/><font point-size="9.5">DLR: labelled options, half reversed<br/>SSR: free-text answers</font>>];
  r2 [label=<<b>Round 2 (900 personas, SSR)</b><br/><font point-size="9.5">N1 self-reflection<br/>N2 random | N3 homophily, k = 3</font>>];
  b2 [label=<<b>Persona-free estimate (B2)</b><br/><font point-size="9.5">same model, country share<br/>mean of 3 runs</font>>];
  ssr [label=<<b>SSR scoring</b><br/><font point-size="9.5">text-embedding-3-small<br/>anchor similarity: P(1..5), T2B</font>>];
  comp [label=<<b>Non-LLM comparators</b><br/><font point-size="9.5">B0, B5, LOCO, B-PROFILE,<br/>B-XITEM, B1</font>>, color="#8a8a8a", fillcolor="#f4f4f4"];
  eval [label=<<b>Evaluation</b><br/><font point-size="9.5">MAE, 1&#8722;MAE, JS similarity,<br/>Spearman, bias, spread, split accuracy<br/>cross-validated CAL-LOCO, CAL-STYLE</font>>, color="#1baf7a", fillcolor="#eef8f3"];

  report -> personas [label="profile only"];
  personas -> r1; personas -> r2; r1 -> r2 [label="own answers,\nneighbours' answers", style=dashed];
  r1 -> ssr; r2 -> ssr; ssr -> eval; r1 -> eval [label="DLR"];
  b2 -> eval; comp -> eval;
  report -> eval [label="printed outcomes: evaluation and cross-validated corrections only", style=dashed, color="#c98a1a", fontcolor="#a06c10", constraint=false];
  { rank=same; r1; r2; b2; }
  { rank=same; ssr; comp; }
  labelloc=b; fontname="Helvetica"; fontsize=9; fontcolor="#555555";
  label="Three models (GPT-5.5, Gemini 3.1 Pro, Claude Sonnet 5), one identical pipeline each; 8,790 calls per model.";
}
